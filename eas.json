{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_TEST_TIMINGS": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "ios-simulator": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_TEST_TIMINGS": "0"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_TEST_TIMINGS": "0"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
